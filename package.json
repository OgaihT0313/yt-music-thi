{
  "name": "yt-music-thi",
  "version": "0.1.0",
  "description": "Player de desktop para o YouTube Music",
  "main": "src/main.js",
  "author": "Thiago",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.thi.ytmusic",
    "productName": "YT Music Thi",
    "files": ["src/**/*", "package.json"],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
